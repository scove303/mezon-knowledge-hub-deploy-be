# Keep only what the backend image needs.
# NOTE: patterns like `*.py`, `*.txt`, `*.json`, `Dockerfile` match at every
# level and would strip backend/requirements.txt and backend/Dockerfile, so
# they must never appear here.
*
!backend/
!backend/**
!railway.json

# VCS and local env
.git
.gitignore
.gitattributes
.env
.env.*
**/.env.local

# Other services and local tooling
frontend/
venv/
mezon-cache/
mezon_sdk_download/
mezon-sdk-python/
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd

# Backend debug dumps and scratch scripts
backend/*.log
backend/check_*.py
backend/test_*.py
backend/debug_*.txt
backend/chat_check.txt
backend/db_check.txt